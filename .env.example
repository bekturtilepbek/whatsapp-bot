# Пример переменных окружения. Реальные значения — только в .env на серверах (ADR-007).
# Дев-значения совпадают с compose/docker-compose.dev.yml (там креды Postgres
# захардкожены как platform/platform/platform — эти три переменные нужны
# только для прод-compose, см. compose/docker-compose.prod.yml).
DATABASE_URL=postgres://platform:platform@localhost:5433/platform
REDIS_URL=redis://localhost:6379/0
GATEWAY_PORT=8080
WORKER_HEALTH_PORT=8081
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Только если хотя бы у одного бота включена тулза send_telegram_lead
# (FEATURES.md 4.7) — без неё тулза просто вернёт текст ошибки клиенту-боту.
TELEGRAM_BOT_TOKEN=

STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/data/media

# Только для docker-compose.prod.yml при STORAGE_DRIVER=s3 (DO Spaces или
# другое S3-совместимое хранилище):
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=fra1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Только для docker-compose.prod.yml:
POSTGRES_USER=platform
POSTGRES_PASSWORD=
POSTGRES_DB=platform

# Только для docker-compose.prod.yml (дев-значения захардкожены в
# docker-compose.dev.yml) — роли и доступы (FEATURES.md 6.18).
JWT_SECRET=
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
