# Пример переменных окружения. Реальные значения — только в .env на серверах (ADR-007).
# Дев-значения совпадают с compose/docker-compose.dev.yml (там креды Postgres
# захардкожены как platform/platform/platform — эти три переменные нужны
# только для прод-compose, см. compose/docker-compose.prod.yml).
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379/0
GATEWAY_PORT=8080
WORKER_HEALTH_PORT=8081
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Только для docker-compose.prod.yml:
POSTGRES_USER=platform
POSTGRES_PASSWORD=
POSTGRES_DB=platform
