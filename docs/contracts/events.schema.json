{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/contracts/events.schema.json",
  "title": "Platform events v1",
  "description": "Контракт событий шины Redis Streams (wa:in / wa:out). Единственный источник истины; из него сверяются Pydantic- и zod-модели.",
  "version": 1,
  "definitions": {
    "inboundText": {
      "type": "object",
      "description": "Входящее сообщение из wa:in.",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "inbound.text" },
        "bot_id": { "type": "string", "format": "uuid" },
        "wa_msg_id": { "type": "string", "minLength": 1 },
        "chat_id": { "type": "string", "minLength": 1 },
        "sender_wa_id": { "type": "string", "minLength": 1 },
        "sender_lid": { "type": ["string", "null"] },
        "from_me": { "type": "boolean" },
        "text": { "type": "string" },
        "quoted_text": { "type": ["string", "null"] },
        "media_type": { "type": ["string", "null"] },
        "storage_key": { "type": ["string", "null"] },
        "mime_type": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"] },
        "ts": { "type": "integer", "description": "unix ms" }
      },
      "required": [
        "type", "bot_id", "wa_msg_id", "chat_id", "sender_wa_id",
        "from_me", "text", "ts"
      ]
    },
    "outboundText": {
      "type": "object",
      "description": "Исходящее текстовое сообщение в wa:out.",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outbound.text" },
        "bot_id": { "type": "string", "format": "uuid" },
        "chat_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "client_msg_id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "bot_id", "chat_id", "text", "client_msg_id"]
    },
    "outboundImage": {
      "type": "object",
      "description": "Исходящее изображение в wa:out (FEATURES.md 4.3/4.4 — карточка товара).",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outbound.image" },
        "bot_id": { "type": "string", "format": "uuid" },
        "chat_id": { "type": "string", "minLength": 1 },
        "storage_key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "client_msg_id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "bot_id", "chat_id", "storage_key", "mime_type", "client_msg_id"]
    },
    "outboundDocument": {
      "type": "object",
      "description": "Исходящий файл в wa:out (FEATURES.md 4.8).",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outbound.document" },
        "bot_id": { "type": "string", "format": "uuid" },
        "chat_id": { "type": "string", "minLength": 1 },
        "storage_key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "client_msg_id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "bot_id", "chat_id", "storage_key", "mime_type", "filename", "client_msg_id"]
    },
    "outboundVideo": {
      "type": "object",
      "description": "Исходящее видео в wa:out (FEATURES.md 4.9).",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outbound.video" },
        "bot_id": { "type": "string", "format": "uuid" },
        "chat_id": { "type": "string", "minLength": 1 },
        "storage_key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "client_msg_id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "bot_id", "chat_id", "storage_key", "mime_type", "client_msg_id"]
    },
    "outboundReaction": {
      "type": "object",
      "description": "Реакция-эмодзи на входящее сообщение клиента, в wa:out (FEATURES.md 9.10).",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outbound.reaction" },
        "bot_id": { "type": "string", "format": "uuid" },
        "chat_id": { "type": "string", "minLength": 1 },
        "reply_to_wa_msg_id": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string", "minLength": 1 },
        "client_msg_id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "bot_id", "chat_id", "reply_to_wa_msg_id", "emoji", "client_msg_id"]
    },
    "outboundTyping": {
      "type": "object",
      "description": "Индикатор \"печатает\" в wa:out.",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outbound.typing" },
        "bot_id": { "type": "string", "format": "uuid" },
        "chat_id": { "type": "string", "minLength": 1 },
        "client_msg_id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "bot_id", "chat_id", "client_msg_id"]
    },
    "sessionStatus": {
      "type": "object",
      "description": "Статус сессии Baileys (публикуется gateway в wa:in).",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "session.status" },
        "bot_id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["connecting", "qr", "open", "reconnecting", "logged_out"]
        },
        "ts": { "type": "integer", "description": "unix ms" }
      },
      "required": ["type", "bot_id", "status", "ts"]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/inboundText" },
    { "$ref": "#/definitions/outboundText" },
    { "$ref": "#/definitions/outboundImage" },
    { "$ref": "#/definitions/outboundDocument" },
    { "$ref": "#/definitions/outboundVideo" },
    { "$ref": "#/definitions/outboundReaction" },
    { "$ref": "#/definitions/outboundTyping" },
    { "$ref": "#/definitions/sessionStatus" }
  ]
}
