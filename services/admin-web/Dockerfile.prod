# Прод: скомпилированная сборка Next.js вместо dev-сервера (см. Dockerfile).
# NEXT_PUBLIC_* запекаются в клиентский бандл на этапе `next build` — их
# нужно передать сюда build-arg'ом (см. compose/docker-compose.prod.yml,
# build.args), рантайм-переменная окружения на уже собранный бандл не
# повлияет.
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
