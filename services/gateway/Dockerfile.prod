# Прод: скомпилированный JS вместо tsx watch (dev-режим — см. Dockerfile).
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
# sharp тянет тяжёлые платформенные бинарники (@img/sharp-*) — retries/timeout
# на случай сетевых обрывов при их загрузке (найдено живьём 2026-09-22).
RUN npm config set fetch-retries 5 && npm config set fetch-retry-mintimeout 20000 \
    && npm config set maxsockets 3 && npm ci

# Baileys генерирует превью-кадр для outbound-видео через ffmpeg
# (extractVideoThumb) — без бинаря превью тихо не заполняется (ошибка гасится
# внутри библиотеки), и видео товара уходит клиенту без превью (FEATURES.md 4.9).
# Тот же блок, что в Dockerfile для dev: стоит после npm ci, чтобы не
# инвалидировать закэшированный npm-слой.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN npm run build

EXPOSE 8080

CMD ["npm", "start"]
